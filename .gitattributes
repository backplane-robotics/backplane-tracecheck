# Normalize line endings in the repository (files were authored on Windows).
* text=auto eol=lf

# Windows-only scripts keep CRLF
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary files: never touch
*.mcap binary
*.png binary
*.woff2 binary

# Keep the lockfile out of diffs and language stats
web/package-lock.json linguist-generated=true -diff
web/src/engine/vendor/** linguist-vendored=true
